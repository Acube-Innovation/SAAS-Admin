# Copy to backend.hcl (not committed) and run: terraform init -backend-config=backend.hcl
bucket       = "schedule-saas-tfstate-123456789012" # bootstrap output: state_bucket
key          = "staging/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
use_lockfile = true # S3-native state locking (Terraform 1.10+)
