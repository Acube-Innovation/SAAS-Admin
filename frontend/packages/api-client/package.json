{
  "name": "@saas/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "openapi-typescript openapi.yaml -o src/schema.d.ts"
  },
  "devDependencies": {
    "@saas/config": "workspace:*",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  }
}
