# Copy to .env for local development:  cp .env.example .env
# Local-only placeholder values. Real secrets live in AWS Secrets Manager, never in git.

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO

# PostgreSQL (POSTGRES_HOST is "db" inside Docker Compose, "localhost" when running Django on the host)
POSTGRES_DB=schedule_saas
# Superuser: used only by the postgres container to bootstrap the roles below. Django never uses it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Table owner: runs migrations (DJANGO_DB_ROLE=owner) and tests. Not superuser, no BYPASSRLS.
POSTGRES_OWNER_USER=app_owner
POSTGRES_OWNER_PASSWORD=app_owner_local
# Runtime role for the API and workers (DJANGO_DB_ROLE=app, the default). Subject to Row-Level Security.
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=app_user_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery (host is "redis" inside Docker Compose)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Host ports published by Docker Compose (change if a port is already used on your machine;
# then also change the port in POSTGRES_PORT / REDIS_URL above for tools run on the host)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
